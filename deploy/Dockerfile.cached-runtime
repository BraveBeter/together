# Prepared by scripts/package-release.mjs; requires the exact verified base lock.
ARG RUNTIME_IMAGE=tongye:local
FROM ${RUNTIME_IMAGE}
USER root
COPY base-dependencies.json /tmp/base-dependencies.json
RUN node -e "require('node:assert/strict').deepEqual(require('/app/package.json').dependencies,require('/tmp/base-dependencies.json'))"
RUN rm -rf /app/.next /app/.next-build /app/src /app/scripts /app/migrations /app/public
COPY --chown=1001:1001 portable-modules/ /app/node_modules/
COPY --chown=1001:1001 build/ /app/.next-build/
COPY --chown=1001:1001 server.js package.json package-lock.json tsconfig.json /app/
COPY --chown=1001:1001 src/ /app/src/
COPY --chown=1001:1001 scripts/ /app/scripts/
COPY --chown=1001:1001 migrations/ /app/migrations/
COPY --chown=1001:1001 public/ /app/public/
WORKDIR /app
USER 1001:1001
CMD ["node", "server.js"]
