{
  "name": "tongye",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:container": "node scripts/verify-container.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "account:create": "node --import tsx scripts/accounts.ts create",
    "account:reset": "node --import tsx scripts/accounts.ts reset",
    "demo": "node --import tsx scripts/demo.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "test:upgrade": "node --import tsx scripts/verify-upgrade.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
